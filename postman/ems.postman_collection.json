{
  "info": {
    "name": "EMS Distributed Resource Matching API",
    "_postman_id": "ems-collection-stage6",
    "description": "Postman collection covering all seven public endpoints and standard error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Request (POST /requests)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('requestId', jsonData.requestId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"water\",\n  \"location\": {\n    \"lat\": 12.9716,\n    \"lon\": 77.5946\n  },\n  \"details\": \"Flooded street, 5 people need drinking water\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests"
          ]
        }
      }
    },
    {
      "name": "2. Get Request (GET /requests/{{requestId}})",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlRequest}}/requests/{{requestId}}",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "{{requestId}}"
          ]
        }
      }
    },
    {
      "name": "3. List Requests (GET /requests)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlRequest}}/requests?type=water",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests"
          ],
          "query": [
            {
              "key": "type",
              "value": "water"
            }
          ]
        }
      }
    },
    {
      "name": "4. Update Request Status (PUT /requests/{{requestId}}/status)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CANCELLED\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests/{{requestId}}/status",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "{{requestId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "5. Manual Match Trigger (POST /match/{{requestId}})",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrlRequest}}/match/{{requestId}}",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "match",
            "{{requestId}}"
          ]
        }
      }
    },
    {
      "name": "6. Register Resource (POST /resources)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('resourceId', jsonData.resourceId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Red Cross water truck 1\",\n  \"type\": \"water\",\n  \"location\": {\n    \"lat\": 12.9352,\n    \"lon\": 77.6245\n  },\n  \"availability\": true\n}"
        },
        "url": {
          "raw": "{{baseUrlResource}}/resources",
          "host": [
            "{{baseUrlResource}}"
          ],
          "path": [
            "resources"
          ]
        }
      }
    },
    {
      "name": "7. List Resources (GET /resources)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlResource}}/resources?type=water&status=AVAILABLE",
          "host": [
            "{{baseUrlResource}}"
          ],
          "path": [
            "resources"
          ],
          "query": [
            {
              "key": "type",
              "value": "water"
            },
            {
              "key": "status",
              "value": "AVAILABLE"
            }
          ]
        }
      }
    },
    {
      "name": "8. Update Resource Status (PUT /resources/{{resourceId}}/status)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"OFFLINE\"\n}"
        },
        "url": {
          "raw": "{{baseUrlResource}}/resources/{{resourceId}}/status",
          "host": [
            "{{baseUrlResource}}"
          ],
          "path": [
            "resources",
            "{{resourceId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "9. Error 400 - Invalid Request Type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"invalid_type\",\n  \"location\": {\n    \"lat\": 12.0,\n    \"lon\": 77.0\n  },\n  \"details\": \"test\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests"
          ]
        }
      }
    },
    {
      "name": "10. Error 400 - Malformed UUID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlRequest}}/requests/not-a-valid-uuid",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "not-a-valid-uuid"
          ]
        }
      }
    },
    {
      "name": "11. Error 404 - Unknown Request ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlRequest}}/requests/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "00000000-0000-0000-0000-000000000000"
          ]
        }
      }
    },
    {
      "name": "12. Error 409 - Illegal Request Status Transition",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PENDING\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests/{{requestId}}/status",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "{{requestId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "13. Error 409 - Client-set ASSIGNED Resource Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ASSIGNED\"\n}"
        },
        "url": {
          "raw": "{{baseUrlResource}}/resources/{{resourceId}}/status",
          "host": [
            "{{baseUrlResource}}"
          ],
          "path": [
            "resources",
            "{{resourceId}}",
            "status"
          ]
        }
      }
    }
  ]
}