{
  "info": {
    "name": "EMS Distributed Resource Matching API",
    "_postman_id": "ems-collection-stage6",
    "description": "Postman collection covering all seven public endpoints and standard error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Request (POST /requests)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "pm.test(\"Has Location header\", function () {",
              "    pm.response.to.have.header(\"Location\");",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Status is PENDING\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"PENDING\");",
              "});",
              "if (jsonData.requestId) {",
              "    pm.environment.set(\"requestId\", jsonData.requestId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"water\",\n  \"location\": {\n    \"lat\": 12.9716,\n    \"lon\": 77.5946\n  },\n  \"details\": \"Flooded street, 5 people need drinking water\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests"
          ]
        }
      }
    },
    {
      "name": "2. Get Request (GET /requests/{{requestId}})",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlRequest}}/requests/{{requestId}}",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "{{requestId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Status is PENDING or MATCHED\", function () {",
              "    pm.expect([\"PENDING\", \"MATCHED\"]).to.include(jsonData.status);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. List Requests (GET /requests)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlRequest}}/requests?type=water",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests"
          ],
          "query": [
            {
              "key": "type",
              "value": "water"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Body has items\", function () {",
              "    pm.expect(jsonData).to.have.property(\"items\");",
              "    pm.expect(jsonData.items).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Update Request Status (PUT /requests/{{requestId}}/status)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CANCELLED\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests/{{requestId}}/status",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests",
            "{{requestId}}",
            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var reqBody = JSON.parse(pm.request.body.raw || \"{}\");",
              "var sentStatus = reqBody.status;",
              "pm.test(\"Status code is 200 or 409\", function () {",
              "    pm.expect([200, 409]).to.include(pm.response.code);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.test(\"Response status matches sent status\", function () {",
              "        pm.expect(jsonData.status).to.eql(sentStatus);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Manual Match Trigger (POST /match/{{requestId}})",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrlRequest}}/match/{{requestId}}",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "match",
            "{{requestId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var code = pm.response.code;",
              "pm.test(\"Status code is 200 or 409\", function () {",
              "    pm.expect([200, 409]).to.include(code);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "var jsonData = pm.response.json();",
              "if (code === 200) {",
              "    pm.test(\"Has matchQueued\", function () {",
              "        pm.expect(jsonData).to.have.property(\"matchQueued\");",
              "    });",
              "} else if (code === 409) {",
              "    pm.test(\"Error code is INVALID_TRANSITION\", function () {",
              "        pm.expect(jsonData.error.code).to.eql(\"INVALID_TRANSITION\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Register Resource (POST /resources)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Status is AVAILABLE and availability is true\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"AVAILABLE\");",
              "    pm.expect(jsonData.availability).to.eql(true);",
              "});",
              "if (jsonData.resourceId) {",
              "    pm.environment.set(\"resourceId\", jsonData.resourceId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Red Cross water truck 1\",\n  \"type\": \"water\",\n  \"location\": {\n    \"lat\": 12.9352,\n    \"lon\": 77.6245\n  },\n  \"availability\": true\n}"
        },
        "url": {
          "raw": "{{baseUrlResource}}/resources",
          "host": [
            "{{baseUrlResource}}"
          ],
          "path": [
            "resources"
          ]
        }
      }
    },
    {
      "name": "7. List Resources (GET /resources)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrlResource}}/resources?type=water&status=AVAILABLE",
          "host": [
            "{{baseUrlResource}}"
          ],
          "path": [
            "resources"
          ],
          "query": [
            {
              "key": "type",
              "value": "water"
            },
            {
              "key": "status",
              "value": "AVAILABLE"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Body has items array and count\", function () {",
              "    pm.expect(jsonData).to.have.property(\"items\");",
              "    pm.expect(jsonData.items).to.be.an(\"array\");",
              "    pm.expect(jsonData).to.have.property(\"count\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
