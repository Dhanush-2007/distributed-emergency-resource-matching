    },
    {
      "name": "9. Error 400 - Invalid Request Type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"invalid_type\",\n  \"location\": {\n    \"lat\": 12.0,\n    \"lon\": 77.0\n  },\n  \"details\": \"test\"\n}"
        },
        "url": {
          "raw": "{{baseUrlRequest}}/requests",
          "host": [
            "{{baseUrlRequest}}"
          ],
          "path": [
            "requests"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
