# Distributed Emergency Resource Matching - Environment Configuration (SPEC Appendix A)
# Ports published to host: coordinator 8000, request-service 8001, resource-service 8002, RabbitMQ UI 15672.

# ==========================================
# Coordinator Settings (Appendix A)
# ==========================================
# Number of logical shards in the system (default: 3)
N_SHARDS=3
# Missed heartbeat intervals before marking a storage node DOWN (default: 3)
MISSED_HEARTBEATS_LIMIT=3
# Coordinator failure detection check period in seconds (default: 1.0)
HEALTH_CHECK_INTERVAL_SEC=1.0
# State directory for coordinator shard state persistence file (default: /state)
STATE_DIR=/state
COORDINATOR_PORT=8000

# ==========================================
# Storage Node Settings (Appendix A)
# ==========================================
# Node identity and logical shard ID (e.g., s1-a, shard 1)
NODE_ID=s0-a
SHARD_ID=0
# Role hint used only on initial bootstrap: primary or replica
INITIAL_ROLE=primary
# Target registration and heartbeat URL for coordinator
COORDINATOR_URL=http://coordinator:8000
# Node advertise address and peer replica address
ADVERTISE_URL=http://s0-a:9000
PEER_URL=http://s0-b:9000
# SQLite database storage directory (default: /data)
DATA_DIR=/data
# Storage node heartbeat period in seconds (default: 2.0)
HEARTBEAT_INTERVAL_SEC=2.0
# Timeout waiting for replica replication acknowledgement in seconds (default: 2.0)
REPLICATION_TIMEOUT_SEC=2.0
# Operation log entries retained before snapshot is required (default: 10000)
OPLOG_RETAIN=10000

# ==========================================
# RabbitMQ Broker Settings (Appendix A)
# ==========================================
# Broker hostname and AMQP port (internal: 5672, management UI: 15672)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Dev credentials (supplied via environment/compose, never hardcoded in app logic)
RABBITMQ_USER=ems
RABBITMQ_PASS=ems-dev-password

# ==========================================
# Request Service Settings (Appendix A)
# ==========================================
REQUEST_SERVICE_PORT=8001
EVENT_PUBLISHER=rabbit
# Outbox sweeper thread configuration (period in seconds and grace period)
SWEEP_ENABLED=true
SWEEP_INTERVAL_SEC=15.0
SWEEP_GRACE_SEC=10.0
# Internal HTTP client timeout in seconds (default: 3.0)
HTTP_TIMEOUT_SEC=3.0

# ==========================================
# Resource Service Settings (Appendix A)
# ==========================================
RESOURCE_SERVICE_PORT=8002
# Reservation reconciler configuration (interval and grace period before auto-releasing orphan reservations)
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SEC=5.0
RECONCILE_GRACE_SEC=60.0

# ==========================================
# Matching Service Settings (Appendix A)
# ==========================================
REQUEST_SERVICE_URL=http://request-service:8001
RESOURCE_SERVICE_URL=http://resource-service:8002
# Maximum retry attempts before routing message to dead-letter queue (default: 3)
MAX_RETRIES=3
# Optional maximum match distance cut-off in km (empty/unset = unlimited)
MAX_MATCH_DISTANCE_KM=
# Fault injection test switches (off by default)
FAULT_MATCH_DELAY_MS=0
FAULT_MATCH_FAIL=off
