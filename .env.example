# Configuration is supplied through environment variables.
# Ports: coordinator 8000, request-service 8001, resource-service 8002,
# matching-service 8003, storage nodes 9000, RabbitMQ 5672/15672.

# Coordinator
STATE_DIR=/state
COORDINATOR_PORT=8000

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ems
RABBITMQ_PASS=ems-dev-password

# Request Service
REQUEST_SERVICE_PORT=8001
EVENT_PUBLISHER=rabbit
SWEEP_ENABLED=true
SWEEP_INTERVAL_SEC=15.0
SWEEP_GRACE_SEC=10.0

# Resource Service
RESOURCE_SERVICE_PORT=8002
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SEC=5.0
RECONCILE_GRACE_SEC=60.0

# Matching Service
MAX_RETRIES=3
MAX_MATCH_DISTANCE_KM=
FAULT_MATCH_DELAY_MS=0
FAULT_MATCH_FAIL=off
